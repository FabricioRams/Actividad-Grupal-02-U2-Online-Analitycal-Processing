{
  "name": "parquetcube-duckdb-olap",
  "version": "1.0.0",
  "private": true,
  "description": "Browser-native OLAP analytics studio powered by DuckDB-WASM and Apache Parquet",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-duckdb-assets.mjs && vite",
    "build": "node scripts/copy-duckdb-assets.mjs && tsc --noEmit && vite build",
